{
  "name": "Flutter App",

  // ── Image ──────────────────────────────────────────────────────────────────
  // Pulls the pre-built dev image from Docker Hub — no local Dockerfile build.
  // Image source: github.com/alihaidar0/flutter-devcontainer
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  // ── Remote environment ────────────────────────────────────────────────────
  "remoteEnv": {
    "GIT_SSH_COMMAND": "ssh -o StrictHostKeyChecking=accept-new"
  },

  // ── VS Code customisations ────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        // ── Flutter & Dart ───────────────────────────────────────────────────
        "Dart-Code.flutter",
        "Dart-Code.dart-code",

        // ── Git ──────────────────────────────────────────────────────────────
        "eamodio.gitlens",
        "mhutchie.git-graph",

        // ── Docker ───────────────────────────────────────────────────────────
        "ms-azuretools.vscode-docker",

        // ── Utilities ────────────────────────────────────────────────────────
        "redhat.vscode-yaml",
        "PKief.material-icon-theme",
        "aaron-bond.better-comments",
        "usernamehw.errorlens",
        "streetsidesoftware.code-spell-checker",
        "mikestead.dotenv",

        // ── AI ───────────────────────────────────────────────────────────────
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],

      "settings": {
        // ── Editor ────────────────────────────────────────────────────────────
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.rulers": [80, 120],
        "editor.renderWhitespace": "boundary",
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false,
        "editor.suggest.preview": true,
        "editor.inlineSuggest.enabled": true,

        // ── Dart / Flutter ────────────────────────────────────────────────────
        "[dart]": {
          "editor.defaultFormatter": "Dart-Code.dart-code",
          "editor.formatOnSave": true,
          "editor.selectionHighlight": false,
          "editor.suggest.snippetsPreventQuickSuggestions": false,
          "editor.suggestSelection": "first",
          "editor.tabCompletion": "onlySnippets",
          "editor.wordBasedSuggestions": "off"
        },
        "dart.flutterSdkPath": "/home/developer/flutter",
        "dart.lineLength": 120,
        "dart.debugExternalPackageLibraries": false,
        "dart.debugSdkLibraries": false,
        "dart.previewFlutterUiGuides": true,
        "dart.previewFlutterUiGuidesCustomTracking": true,
        "dart.showInspectorNotificationsForWidgetErrors": true,

        // ── Files ─────────────────────────────────────────────────────────────
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.eol": "\n",
        "files.associations": {
          "**/*.env*": "dotenv",
          "Dockerfile*": "dockerfile",
          "*.sh": "shellscript",
          "*.arb": "json"
        },
        "files.exclude": {
          "**/.git": false,
          "**/.dart_tool": true,
          "**/build": true,
          "**/.flutter-plugins": true,
          "**/.flutter-plugins-dependencies": true
        },
        "files.watcherExclude": {
          "**/build/**": true,
          "**/.dart_tool/**": true
        },

        // ── Search ────────────────────────────────────────────────────────────
        "search.exclude": {
          "**/build": true,
          "**/.dart_tool": true,
          "**/node_modules": true,
          "**/coverage": true
        },

        // ── Terminal ──────────────────────────────────────────────────────────
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontSize": 14,
        "terminal.integrated.scrollback": 5000,

        // ── Explorer sidebar ──────────────────────────────────────────────────
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.expand": false,
        "explorer.fileNesting.patterns": {
          "pubspec.yaml": "pubspec.lock, .flutter-plugins, .flutter-plugins-dependencies, .metadata, analysis_options.yaml",
          ".env": ".env.*, .envrc",
          "README.md": "CHANGELOG.md, CONTRIBUTING.md, LICENSE"
        },

        // ── Git ───────────────────────────────────────────────────────────────
        "git.autofetch": true,
        "git.confirmSync": false,
        "git.enableSmartCommit": true,
        "gitlens.hovers.currentLine.over": "line",

        // ── Error Lens ────────────────────────────────────────────────────────
        "errorLens.enabledDiagnosticLevels": ["error", "warning"],
        "errorLens.followCursor": "allLines",

        // ── Spell checker ─────────────────────────────────────────────────────
        "cSpell.words": [
          "commitlint",
          "devcontainer",
          "dockerfile",
          "flutterfire",
          "husky",
          "pubspec",
          "riverpod",
          "widgetbook"
        ]
      }
    }
  },

  // ── Port forwarding ───────────────────────────────────────────────────────
  // 8080 — flutter run -d web-server binds here inside the container.
  // Opened as URL so the developer sees the web build immediately.
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Flutter Web",
      "onAutoForward": "openBrowser"
    }
  },

  // ── Lifecycle hooks ───────────────────────────────────────────────────────
  //
  // postCreateCommand — runs once when the container is first created.
  //
  //   1. sudo git config --system --add safe.directory /workspace
  //      On Windows/macOS, /workspace is a bind mount from the host, so the
  //      container's 'developer' user does not match the host's file owner.
  //      Git's ownership check then refuses to operate on it at all —
  //      including from scripts run non-interactively — and fails with
  //      "fatal: not in a git directory" or "dubious ownership". This must
  //      run BEFORE `pnpm install`, because Husky's own `prepare` script
  //      (triggered by install) immediately runs `git rev-parse` to register
  //      hooks.
  //
  //      System scope (not --global) because ~/.gitconfig is bind-mounted
  //      READ-ONLY from the host (see docker-compose.yml, ":ro" suffix on the
  //      .gitconfig volume). A --global write here fails outright with
  //      "error: could not write config file ... Device or resource busy",
  //      which aborts postCreateCommand entirely (exit code 4) and skips
  //      Corepack/pnpm install too. /etc/gitconfig has no such restriction.
  //      welcome.sh (postStartCommand) sets this same entry on every start as
  //      a safety net — both calls are safe to keep, Git no-ops on duplicates.
  //
  //   2. Corepack enable/prepare — installs Husky + commitlint and registers
  //      all git hooks automatically. Safe to run on a fresh template:
  //      package.json is always present and `pnpm install` only installs the
  //      two declared devDependencies. Flutter is NOT initialised here — the
  //      developer does that manually.
  //
  //      Corepack (which provides pnpm) ships with Node but is dormant until
  //      enabled, and its shim lives in /usr/local/bin, which is root-owned —
  //      so activation needs `sudo`. `flutter-devcontainer` now activates
  //      Corepack/pnpm at image build time, so this explicit step is normally
  //      a no-op once you're on an image built after that fix; it's kept here
  //      as a safety net so this template still works correctly against older
  //      cached images.
  //
  //      IMPORTANT: `sudo` starts a fresh process with a sanitized environment,
  //      so `VAR=0 sudo cmd` does NOT pass VAR through to the sudo'd process —
  //      only `sudo env VAR=0 cmd` (or `sudo -E`, which requires visudo config)
  //      reliably does. COREPACK_ENABLE_DOWNLOAD_PROMPT=0 must be set this way
  //      on BOTH the `enable` and `prepare` calls, since either can trigger
  //      Corepack's first-run download. Without this, postCreateCommand runs
  //      non-interactively and will hang forever on the [Y/n] prompt with no
  //      way to answer it — the container creation silently stalls.
  //
  // postStartCommand — runs on every container start.
  //   Shows a context-aware Flutter getting-started banner.
  //
  "postCreateCommand": "sudo git config --system --add safe.directory /workspace && sudo env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack enable && sudo env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack prepare pnpm@latest --activate && pnpm install",
  "postStartCommand": "bash /workspace/scripts/welcome.sh",

  // ── Remote user ───────────────────────────────────────────────────────────
  // Matches the non-root 'developer' user created in the devcontainer image.
  // All Flutter SDK paths, pub cache, and Android SDK are owned by this user.
  "remoteUser": "developer"
}
