while read -r _ _ remote_ref _; do
  branch="${remote_ref#refs/heads/}"
  if [ "$branch" = "main" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════╗"
    echo "║  Direct push to 'main' is blocked               ║"
    echo "╠══════════════════════════════════════════════════╣"
    echo "║  Push to a feature branch, then open a PR.      ║"
    echo "╚══════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi
done

exit 0
